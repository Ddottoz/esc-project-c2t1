<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload Submission</title>

    <link rel="stylesheet" href="/stylesheets/upload.css">

</head>

<body>
<div id=""upload-page>
    <header class="top-navigation">
        <a href="/bands" class="logo-link" aria-label="DAS home">
        <img src="/images/das-logo.jpg" alt="Dyslexia Association of Singapore logo" class="das-logo">
        </a>

        <nav class="navigation-links">
        <a href="/bands" class="navigation-item active">Bands</a>
        <a href="/students" class="navigation-item">Students</a>
        </nav>

        <a href="/educator" class="profile-button" aria-label="Open account">
        <img src="/images/profile_icon.webp" alt="" class="profile-icon" aria-hidden="true">
        </a>
    </header>

    <div class="page">
        <aside id="sidebar" class="sidebar">
            <button id="sidebar-toggle" type="button" class="sidebar-toggle" aria-label="Toggle sidebar" title="Toggle sidebar">
                <span class="toggle-arrow">‹</span>
                <span class="toggle-menu">☰</span>
            </button>

            <section class="band-information">
                <h2>Band <%= assessment.band %></h2>
                <h3><%= assessment.academicYear %> Semester <%= assessment.semNo %></h3>
                <p><%= assessment.assessmentType %></p>
            </section>

            <a
                href="/submission/<%= assessment.semId %>/<%= encodeURIComponent(assessment.band) %>/<%= encodeURIComponent(String(assessment.assessmentType).replace(/ /g, "_")) %>"
                class="back-to-submissions"
            >&lt; Back to Submissions</a>

            <nav class="sidebar-navigation">
                <a href="/upload/<%= assessment.studentAssessmentId %>" class="sidebar-link active" title="Upload">
                <span class="sidebar-icon">
                    <img src="/images/upload.png" alt="" class="upload-sidebar-icon" aria-hidden="true">
                </span>
                <span class="sidebar-link-label">Upload</span>
                </a>

                <a href="/viewanalysis/<%= assessment.studentAssessmentId %>" class="sidebar-link" title="Review">
                <span class="sidebar-icon"><img src="/images/review.png" alt="" class="review-sidebar-icon" aria-hidden="true"></span>
                <span class="sidebar-link-label">Review</span>
                </a>
            </nav>
        </aside>
        <main>
    <!-- Header -->
        <h1>Upload Submission: <%= assessment.assessmentType %></h1>

        <p class="student-name"><%= assessment.studentId %></p>

        <!-- Instructions -->
        <section class="instructions">

            <h2>Instructions</h2>

            <p>PDF file only</p>

        </section>

        <!-- Submission -->
        <h2>Upload PDF Document</h2>
        

        <form action="/upload/<%= studentAssessmentId %>" method="POST" enctype="multipart/form-data">

            <div>
                <label for="pdf">Select PDF File</label><br>

                <input
                    type="file"
                    id="pdf"
                    name="pdf"
                    accept=".pdf,application/pdf"
                    required>
            </div>

            <br>


            <div class="comment-panel">

                <label class="comment-label">
                    Add Comments
                </label>

                <textarea rows="6" name="comment"></textarea>

            </div>


            <div class="button-group">

                <!-- <button type="button" class="cancel">
                    Cancel
                </button> -->

                <!-- This submits the form -->
                <button type="submit" class="submit">
                    Submit
                </button>

            </div>

        </form>
        <h2>Uploaded File</h2>

        <% if (files && files.length > 0) { %>

        <ul>

            <% files.forEach(file => { %>

                <li>
                    <a href="<%= file.filepath %>" target="_blank">
                        <%= file.id %>
                    </a>
                </li>

            <% }) %>

        </ul>

        <% } else { %>

        <p>No files uploaded yet.</p>

        <% } %>
        </main>
        

    </div>
</div>

<script>
    const message = "<%= message %>";

    if (message === "success") {
        alert("Upload successful!");
    }

    if (message === "fail") {
        alert("Upload failed!");
    }
</script>
</body>
</html>