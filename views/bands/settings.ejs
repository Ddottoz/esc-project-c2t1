<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Edit <%= band.name %></title>
    <link rel="stylesheet" href="/stylesheets/bands.css">
</head>

<body>
<div class="app-shell">
    <%- include('../partials/top-nav', {activeTop: 'bands'}) %>
    <%- include('../partials/sidebar', {type: 'band', activeSide: 'settings'}) %>

    <main class="content-page settings-page">
        <h1>Edit Band</h1>

        <% if (error) { %>
            <div class="alert error"><%= error %></div>
        <% } %>
        <% if (saved) { %>
            <div class="alert success">Band updated.</div>
        <% } %>

        <form id="settings-form" method="post" action="/bands/<%= band.id %>/settings" data-dirty-form>
            <div class="form-grid compact">
                <label>
                    Year
                    <select name="year" required>
                        <% [2026, 2027, 2028, 2029, 2030, 2031, 2032, 2033, 2034, 2035].forEach(year => { %>
                            <option value="<%= year %>" <%= Number(band.year) === year ? 'selected' : '' %>>
                                <%= year %>
                            </option>
                        <% }) %>
                    </select>
                </label>

                <label>
                    Semester
                    <select name="semester" required>
                        <option <%= band.semester === 'Semester 1' ? 'selected' : '' %>>Semester 1</option>
                        <option <%= band.semester === 'Semester 2' ? 'selected' : '' %>>Semester 2</option>
                    </select>
                </label>

                <label class="full">
                    Band Description
                    <textarea name="description"><%= band.description %></textarea>
                </label>
            </div>

            <section>
                <h2>Scoring Rubrics</h2>
                <div class="table-wrap">
                    <table>
                        <thead>
                        <tr>
                            <th>Assessment Name</th>
                            <th>Points</th>
                            <th>Passing Points</th>
                            <th>Weightage (%)</th>
                        </tr>
                        </thead>
                        <tbody>
                        <% band.assessments.forEach(assessment => { %>
                            <tr>
                                <td><%= assessment.name %></td>
                                <td><%= assessment.maxPoints %></td>
                                <td><%= assessment.passingPoints %></td>
                                <td>
                                    <input
                                        class="weight-input"
                                        name="weight_<%= assessment.id %>"
                                        type="number"
                                        min="0"
                                        max="100"
                                        step="0.0001"
                                        required
                                        value="<%= assessment.weight %>"
                                    >
                                </td>
                            </tr>
                        <% }) %>
                        </tbody>
                    </table>
                </div>
                <p>Student needs 90% total and must meet every assessment's passing points to pass.</p>
            </section>

            <section>
                <h2>Educators</h2>
                <div id="educator-rows">
                    <% band.educators.forEach(educator => { %>
                        <div class="educator-row">
                            <input name="educatorName" value="<%= educator.name %>" required aria-label="Educator name">
                            <select name="educatorCentre">
                                <option <%= educator.centre === 'Centre 1' ? 'selected' : '' %>>Centre 1</option>
                                <option <%= educator.centre === 'Centre 2' ? 'selected' : '' %>>Centre 2</option>
                            </select>
                            <select name="educatorRole">
                                <option <%= educator.role === 'Lead Educator' ? 'selected' : '' %>>Lead Educator</option>
                                <option <%= educator.role === 'Supporting Educator' ? 'selected' : '' %>>Supporting Educator</option>
                            </select>
                            <button class="icon-button danger remove-educator" type="button" aria-label="Remove educator">
                                <span class="trash-icon" aria-hidden="true"></span>
                            </button>
                        </div>
                    <% }) %>
                </div>

                <button class="button secondary" id="add-educator" type="button">+ Add Educator</button>
            </section>

            <div class="settings-actions">
                <button class="button secondary danger delete-band-trigger" type="button" data-open-modal="delete-band-modal">
                    <span class="trash-icon" aria-hidden="true"></span>
                    Delete Band
                </button>
                <button class="button primary" type="submit">Update Band</button>
            </div>
        </form>
    </main>
</div>

<div class="modal-backdrop" id="delete-band-modal" hidden>
    <section class="modal delete-band-modal" role="dialog" aria-modal="true">
        <button class="modal-close" data-close-modal type="button">&times;</button>
        <h2>Delete <%= band.year %> <%= band.semester %> <%= band.name %>?</h2>
        <p>This permanently deletes the Band and all tied assessments and enrollments.</p>
        <form method="post" action="/bands/<%= band.id %>/delete">
            <button class="button delete-confirm-button" type="submit">Delete Band</button>
        </form>
    </section>
</div>

<template id="educator-template">
    <div class="educator-row">
        <input name="educatorName" required placeholder="Educator name" aria-label="Educator name">
        <select name="educatorCentre">
            <option>Centre 1</option>
            <option>Centre 2</option>
        </select>
        <select name="educatorRole">
            <option>Lead Educator</option>
            <option>Supporting Educator</option>
        </select>
        <button class="icon-button danger remove-educator" type="button" aria-label="Remove educator">
            <span class="trash-icon" aria-hidden="true"></span>
        </button>
    </div>
</template>

<script src="/javascripts/bands.js"></script>
</body>

</html>
