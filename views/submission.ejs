<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/submission.css">
</head>
<body>
  <% const placeholderUrl = "https://en.wikipedia.org/wiki/Internet_meme"; %>
  <div
    id="submission-page"
    class="submission-page"
  >
    <header class="top-navigation">
      <a href="/bands" class="logo-link" aria-label="DAS home">
        <img src="/images/das-logo.jpg" alt="Dyslexia Association of Singapore logo" class="das-logo">
      </a>

      <nav class="navigation-links">
        <a href="/bands" class="navigation-item active">Bands</a>
        <a href="/students" class="navigation-item">Students</a>
      </nav>

      <a href="/educator" class="profile-button" aria-label="Open account">
        <img src="/images/profile_icon.webp" alt="" class="profile-icon" aria-hidden="true">
      </a>
    </header>

    <div class="workspace">
      <aside id="sidebar" class="sidebar">
        <button id="sidebar-toggle" type="button" class="sidebar-toggle" aria-label="Toggle sidebar" title="Toggle sidebar">
          <span class="toggle-arrow">‹</span>
          <span class="toggle-menu">☰</span>
        </button>

        <section class="band-information">
          <h2>Band<%= submissionPage.band %></h2>
          <h3><%= submissionPage.semester.academicYear %> Semester <%= submissionPage.semester.semesterNo %></h3>
          <p><%= submissionPage.assessmentType %></p>
        </section>

        <a
          href="/assessments/<%= encodeURIComponent(submissionPage.semester.semesterBandId) %>/view"
          class="back-to-assessments"
        >&lt; Back to Assessments
        </a>

        <nav class="sidebar-navigation">
          <!-- answer keys are viewed through the assessment rubrics page -->
          <a
            href="/assessments/<%= encodeURIComponent(submissionPage.semester.semesterBandId) %>/view"
            class="sidebar-link"
            title="Answer Key"
          >
            <span class="sidebar-icon">
              <img src="/images/answer_key.png" alt="" class="answer-key-sidebar-icon" aria-hidden="true">
            </span>
                        
            <span class="sidebar-link-label">Answer Key</span>
          </a>

          <a
            href="/submission/<%= submissionPage.semester.semesterId %>/<%= encodeURIComponent(submissionPage.band) %>/<%= encodeURIComponent(String(submissionPage.assessmentType).replace(/ /g, "_")) %>"
            class="sidebar-link active"
            title="Submissions"
          >
            <span class="sidebar-icon assessment-sidebar-icon" aria-hidden="true"></span>
            <span class="sidebar-link-label">Submissions</span>
          </a>
        </nav>
      </aside>

      <main class="submissions-main">
        <header class="submissions-heading">
          <h1>Submissions: <%= submissionPage.assessmentType %></h1>
        </header>

        <div class="submission-table-wrapper">
          <table class="submission-table">
            <thead>
              <tr>
                <th aria-sort="none">
                  <button type="button" class="submission-sort-button" data-sort-key="name" data-sort-type="text">
                    Name
                    <span class="submission-sort-icon" aria-hidden="true"></span>
                  </button>
                </th>
                <th aria-sort="none">
                  <button type="button" class="submission-sort-button" data-sort-key="score" data-sort-type="number">
                    Score
                    <span class="submission-sort-icon" aria-hidden="true"></span>
                  </button>
                </th>
                <th aria-sort="none">
                  <button type="button" class="submission-sort-button" data-sort-key="status" data-sort-type="text">
                    Status
                    <span class="submission-sort-icon" aria-hidden="true"></span>
                  </button>
                </th>
                <th aria-sort="none">
                  <button type="button" class="submission-sort-button" data-sort-key="date" data-sort-type="date">
                    Due Date
                    <span class="submission-sort-icon" aria-hidden="true"></span>
                  </button>
                </th>
                <th aria-label="Upload"></th>
                <th aria-label="Review"></th>
              </tr>
            </thead>

            <tbody>
              <% if (submissionPage.submissions.length === 0) { %>
                <tr>
                  <td colspan="6" class="empty-submissions">No submissions available.</td>
                </tr>
              <% } %>

              <% submissionPage.submissions.forEach(function(submission, index) { %>
                <tr class="submission-row" data-original-index="<%= index %>">
                  <td data-sort-name="<%= submission.studentName.toLocaleLowerCase('en-SG') %>">
                    <a
                      class="student-name-link"
                      href="/bands/<%= encodeURIComponent(submissionPage.semester.semesterBandId) %>/students/<%= encodeURIComponent(submission.studentId) %>"
                    ><%= submission.studentName %></a>
                  </td>
                  <td data-sort-score="<%= typeof submission.score === 'number' ? submission.score : '' %>"><%= submission.score %></td>

                  <td data-sort-status="<%= submission.status.toLocaleLowerCase('en-SG') %>">
                    <span class="status-label status-<%= submission.statusClass %>"><%= submission.status %></span>
                  </td>

                  <td data-sort-date="<%= submission.dueDateSort %>"><%= submission.dueDate %></td>

                  <td>
                    <% if (submission.studentAssessmentId) { %>
                      <a href="/upload/<%= submission.studentAssessmentId %>" class="table-action table-action-enabled">
                        <img src="/images/upload.png" alt="" class="upload-action-icon" aria-hidden="true">
                        <span>Upload</span>
                      </a>
                    <% } else { %>
                      <!-- legacy enrollment is shown even if its assignment record is missing -->
                      <span class="table-action table-action-disabled" aria-disabled="true" title="Assessment is not assigned yet">
                        <img src="/images/upload.png" alt="" class="upload-action-icon" aria-hidden="true">
                        <span>Upload</span>
                      </span>
                    <% } %>
                  </td>

                  <td>
                    <% if (submission.hasAnalysis) { %>
                      <a
                        href="/viewanalysis/<%= submission.studentAssessmentId %>"
                        class="table-action table-action-enabled"
                      >
                        <img src="/images/review.png" alt="" class="review-action-icon" aria-hidden="true">
                        <span>Review</span>
                      </a>
                    <% } else { %>
                      <span
                        class="table-action table-action-disabled"
                        aria-disabled="true"
                      >
                        <img src="/images/review.png" alt="" class="review-action-icon" aria-hidden="true">
                        <span>Review</span>
                      </span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </main>
    </div>
  </div>

  <script src="/javascripts/submission.js"></script>
</body>
</html>
