<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= student.name %> Dashboard</title>
    <link rel="stylesheet" href="/stylesheets/bands.css">
</head>

<body>
<div class="app-shell">
    <%- include('../partials/top-nav', {activeTop: 'bands'}) %>
    <%- include('../partials/sidebar', {type: 'student', activeSide: 'dashboard', student}) %>

    <main class="content-page">
        <h1><%= student.name %></h1>
        <!-- makes it clear when this is a current or past Band dashboard -->
        <p class="dashboard-band-context"><%= band.name %> &middot; <%= band.year %> <%= band.semester %></p>

        <section>
            <h2>Assessments</h2>
            <div class="table-wrap assessment-table-wrap">
                <table class="assessment-table">
                    <colgroup>
                        <col class="assessment-name-column">
                        <col class="assessment-score-column">
                        <col class="assessment-weight-column">
                        <col class="assessment-status-column">
                        <col class="assessment-submitted-column">
                        <col class="assessment-actions-column">
                    </colgroup>
                    <thead>
                    <tr>
                        <th>Name</th>
                        <th>Score</th>
                        <th>Weight %</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    <% assessments.forEach(assessment => { %>
                        <tr>
                            <td>
                                <a class="assessment-name-link" href="/bands/<%= band.id %>/assessments/<%= assessment.id %>">
                                    <%= assessment.name %>
                                </a>
                            </td>
                            <td>
                                <%= Number.isFinite(assessment.submission.score)
                                    ? assessment.submission.score + '/' + assessment.maxPoints
                                    : '--/' + assessment.maxPoints %>
                            </td>
                            <td class="numeric-cell"><%= assessment.weight %>%</td>
                            <td class="status-cell">
                                <span class="status-badge status-<%= assessment.submission.status.toLowerCase() %>">
                                    <%= assessment.submission.status %>
                                </span>
                            </td>
                            <td>
                                <%= assessment.submission.submittedAt
                                    ? new Date(assessment.submission.submittedAt).toLocaleString('en-SG')
                                    : '--' %>
                            </td>
                            <td class="actions assessment-actions">
                                <div class="assessment-action-list">
                                    <% if (assessment.submission.studentAssessmentId) { %>
                                        <a
                                            class="assessment-action assessment-action-enabled"
                                            href="/bands/<%= band.id %>/students/<%= student.id %>/assessments/<%= assessment.id %>/upload"
                                        >
                                            <img src="/images/upload.png" alt="" class="upload-action-icon" aria-hidden="true">
                                            <span>Upload</span>
                                        </a>
                                    <% } else { %>
                                        <span class="assessment-action assessment-action-disabled" aria-disabled="true">
                                            <img src="/images/upload.png" alt="" class="upload-action-icon" aria-hidden="true">
                                            <span>Upload</span>
                                        </span>
                                    <% } %>
                                    <% if (assessment.submission.studentAssessmentId && assessment.submission.hasAnalysis) { %>
                                        <a
                                            class="assessment-action assessment-action-enabled"
                                            href="/bands/<%= band.id %>/students/<%= student.id %>/assessments/<%= assessment.id %>/review"
                                        >
                                            <img src="/images/review.png" alt="" class="review-action-icon" aria-hidden="true">
                                            <span>Review</span>
                                        </a>
                                    <% } else { %>
                                        <span class="assessment-action assessment-action-disabled" aria-disabled="true">
                                            <img src="/images/review.png" alt="" class="review-action-icon" aria-hidden="true">
                                            <span>Review</span>
                                        </span>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
            </div>

            <p class="summary-row">
                Status:
                <strong class="<%= passed ? 'pass' : 'fail' %>"><%= passed ? 'PASS' : 'FAIL' %></strong>
                (<%= earned %>% weighted score; <%= required %>% required)
            </p>
        </section>

        <section class="past-bands-section">
            <h2>Past Bands</h2>
            <div class="table-wrap narrow">
                <table>
                    <thead>
                    <tr>
                        <th>Date</th>
                        <th>Band</th>
                        <th>Score</th>
                    </tr>
                    </thead>
                    <tbody>
                    <% pastBands.forEach(pastBand => { %>
                        <tr>
                            <td><%= pastBand.term %></td>
                            <td>
                                <% if (pastBand.bandId) { %>
                                    <!-- opens the same student's dashboard for the selected past Band -->
                                    <a
                                        class="past-band-link"
                                        href="/bands/<%= pastBand.bandId %>/students/<%= student.id %>"
                                        title="Open <%= pastBand.band %> dashboard for <%= pastBand.term %>"
                                    >
                                        <%= pastBand.band %>
                                    </a>
                                <% } else { %>
                                    <%= pastBand.band %>
                                <% } %>
                            </td>
                            <td>
                                <span class="status-badge status-<%= pastBand.status.toLowerCase() %>">
                                    <%= pastBand.status %>
                                </span>
                            </td>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</div>

<script src="/javascripts/bands.js"></script>
</body>

</html>
