<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Edit Educator Information</title>
    <link rel="stylesheet" href="/stylesheets/bands.css">
    <link rel="stylesheet" href="/stylesheets/edit-educator.css">
</head>
<body>
<div class="app-shell standalone">
    <%- include('partials/top-nav', {activeTop: ''}) %>

    <main class="educator-page">
        <h1>Edit Educator Information</h1>

        <% if (message) { %>
            <p class="message"><%= message %></p>
        <% } %>

        <form action="/educator" method="POST">

            <h2>Basic Educator Information</h2>

            <div class="row">
                <div class="field">
                    <label for="firstName">First Name</label>
                    <input type="text" id="firstName" name="firstName" value="<%= firstName %>" required>
                </div>

                <div class="field">
                    <label for="lastName">Last Name</label>
                    <input type="text" id="lastName" name="lastName" value="<%= lastName %>">
                </div>
            </div>

            <div class="row">
                <div class="field">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" value="<%= educator.email %>"
                           placeholder="e.g. email@example.com" required>
                </div>
            </div>

            <div class="row">
                <div class="field">
                    <label for="password">Password</label>
                    <input type="password" id="password" value="password placeholder" disabled>
                    <button type="button" class="link-button" id="showPasswordBtn">Show</button>
                </div>

                <div class="field">
                    <button type="button" class="grey-button" id="changePasswordBtn">Change Password</button>
                </div>
            </div>

            <div id="passwordFields" class="hidden">
                <div class="row">
                    <div class="field">
                        <label for="newPassword">New Password</label>
                        <input type="password" id="newPassword" name="newPassword">
                    </div>

                    <div class="field">
                        <label for="confirmPassword">Confirm New Password</label>
                        <input type="password" id="confirmPassword" name="confirmPassword">
                    </div>
                </div>
            </div>

            <h2>DAS Programme Information</h2>

            <!-- Placeholder rows. semesterBandEducator stores the educator's name as
                 free text, so there is no reliable way to look up this educator's own
                 bands yet. Load the real rows once that table links to educatorId. -->
            <table>
                <tr>
                    <th>Year</th>
                    <th>Semester</th>
                    <th>Band</th>
                    <th>Role</th>
                    <th>Centre</th>
                </tr>
                <tr>
                    <td>2026</td>
                    <td>Semester 2</td>
                    <td>A2</td>
                    <td>Lead Educator</td>
                    <td><%= educator.centreName || 'Not set' %></td>
                </tr>
            </table>

            <button type="submit" class="save-button">Save Changes</button>

        </form>
    </main>
</div>

<script src="/javascripts/edit-educator.js"></script>
</body>
</html>
