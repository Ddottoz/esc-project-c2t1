<!DOCTYPE html>
<html>

<head>
    <title>Edit Educator Information</title>
    <link rel="stylesheet" href="/stylesheets/edit-educator.css">
</head>

<body>

<%- include('partials/navbar') %>

<div class="page">

    <h1>Edit Educator Information</h1>

    <% if (message) { %>
        <p class="message"><%= message %></p>
    <% } %>

    <form action="/educator" method="POST">

        <h2>Basic Educator Information</h2>

        <div class="row">
            <div class="field">
                <label for="firstName">First Name</label>
                <input type="text" id="firstName" name="firstName" value="<%= firstName %>" required>
            </div>

            <div class="field">
                <label for="lastName">Last Name</label>
                <input type="text" id="lastName" name="lastName" value="<%= lastName %>">
            </div>
        </div>

        <div class="row">
            <div class="field">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="email" value="<%= educator.email %>"
                       placeholder="e.g. email@example.com" required>
            </div>
        </div>

        <div class="row">
            <div class="field">
                <label for="password">Password</label>
                <input type="password" id="password" value="password placeholder" disabled>
                <button type="button" class="eye" id="showPasswordBtn">Show</button>
            </div>

            <div class="field">
                <button type="button" class="grey" id="changePasswordBtn">Change Password</button>
            </div>
        </div>

        <div id="passwordFields" class="hidden">
            <div class="row">
                <div class="field">
                    <label for="newPassword">New Password</label>
                    <input type="password" id="newPassword" name="newPassword">
                </div>

                <div class="field">
                    <label for="confirmPassword">Confirm New Password</label>
                    <input type="password" id="confirmPassword" name="confirmPassword">
                </div>
            </div>
        </div>

        <h2>DAS Programme Information</h2>

        <!-- Placeholder rows. The database has no table linking an educator to a
             semester, band and role yet, so nothing real can be loaded here. -->
        <table>
            <tr>
                <th>Year</th>
                <th>Semester</th>
                <th>Band</th>
                <th>Role</th>
                <th>Centre</th>
            </tr>
            <tr>
                <td>2026</td>
                <td>Semester 2</td>
                <td>A2</td>
                <td>Lead Educator</td>
                <td><%= educator.centreName || 'Not set' %></td>
            </tr>
        </table>

        <button type="submit" class="save">Save Changes</button>

    </form>

</div>

<script src="/javascripts/edit-educator.js"></script>

</body>
</html>
