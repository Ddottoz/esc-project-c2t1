<!DOCTYPE html>
<html lang="en">

<head>
    <title>assessmentList</title>

    <link rel="stylesheet" href="/stylesheets/assessmentList.css">
</head>

<body data-semester-id="<%= semesterId %>" data-band="<%= band %>">

    <div class="pageHeader">
        <h1 id="assessmentCountTitle">0 Assessments</h1>
        <button id="addAssessmentBtn">Create Assessment</button>
    </div>

    <table>
        <thead>
            <tr>
                <th>
                    <select class="filterInput" id="filterAssessmentType" name="assessmentType">
                        <option value="">All Types</option>
                        <option value="Letter Formation">Letter Formation</option>
                        <option value="Narrative Writing">Narrative Writing</option>
                        <option value="Exposition Writing">Exposition Writing</option>
                        <option value="Edit and Diagram 1">Edit and Diagram 1</option>
                        <option value="Edit and Diagram 2">Edit and Diagram 2</option>
                        <option value="Edit and Diagram 3">Edit and Diagram 3</option>
                        <option value="Comprehension">Comprehension</option>
                        <option value="Primary">Primary</option>
                        <option value="Secondary">Secondary</option>
                        <option value="Picture Naming">Picture Naming</option>
                        <option value="Picture Description">Picture Description</option>
                        <option value="PA Identification">PA Identification</option>
                        <option value="Phonics">Phonics</option>
                        <option value="Word Reading Accuracy">Word Reading Accuracy</option>
                        <option value="Fluency">Fluency</option>
                        <option value="Word Spelling">Word Spelling</option>
                    </select>

                </th>
                <th>
                    <select class="filterInput" id="filterComponent" name="component">
                        <option value="">All Components</option>
                        <option value="Vocabulary">Vocabulary</option>
                        <option value="Writing">Writing</option>
                        <option value="Comprehension">Comprehension</option>
                        <option value="PA / Phonics">PA / Phonics</option>
                    </select>
                </th>
                <th></th>
                <th></th>
                <th></th>

                <th></th>
                <th>

                </th>
            </tr>
            <tr>
                <th>Assessment Type</th>
                <th>Component</th>
                <th>Submitted</th>
                <th>Graded</th>
                <th>Passing Mark</th>
                <th>Total Mark</th>
                <th>Weightage</th>
                <th>Rubrics</th>
                <th>Published</th>
                <th>Actions</th>

            </tr>
        </thead>
        <tbody id="assessmentTableBody"></tbody>
    </table>

    <div id="assessmentModal" style="display:none;">
        <div class="modalContent">
            <h2 id="modalTitle">Create Assessment</h2>

            <form id="assessmentForm">
                <input type="hidden" id="assessmentId" />

                <label for="assessmentType">Assessment Type</label>
                <select id="assessmentType" required>
                    <option value="" disabled selected>Select Type</option>
                    <option value="Letter Formation">Letter Formation</option>
                    <option value="Narrative Writing">Narrative Writing</option>
                    <option value="Exposition Writing">Exposition Writing</option>
                    <option value="Edit and Diagram 1">Edit and Diagram 1</option>
                    <option value="Edit and Diagram 2">Edit and Diagram 2</option>
                    <option value="Edit and Diagram 3">Edit and Diagram 3</option>
                    <option value="Comprehension">Comprehension</option>
                    <option value="Primary">Primary</option>
                    <option value="Secondary">Secondary</option>
                    <option value="Picture Naming">Picture Naming</option>
                    <option value="Picture Description">Picture Description</option>
                    <option value="PA Identification">PA Identification</option>
                    <option value="Phonics">Phonics</option>
                    <option value="Word Reading Accuracy">Word Reading Accuracy</option>
                    <option value="Fluency">Fluency</option>
                    <option value="Word Spelling">Word Spelling</option>
                </select>

                <label for="component">Component</label>
                <select id="component" required>
                    <option value="" disabled selected>All Components</option>
                    <option value="Vocabulary">Vocabulary</option>
                    <option value="Writing">Writing</option>
                    <option value="Comprehension">Comprehension</option>
                    <option value="PA / Phonics">PA / Phonics</option>
                </select>

                <label for="passingMark">Passing Mark</label>
                <input type="number" id="passingMark" required />

                <label for="totalMark">Total Mark</label>
                <input type="number" id="totalMark" required />

                <label for="weight">Weightage</label>
                <input type="number" step="any" id="weight" required />

                <label for="rubrics">Rubrics</label>
                <textarea rows="10" cols="50" id="rubrics" placeholder=" Enter rubrics"></textarea>

                <div class="modalActions">
                    <button type="button" id="cancelModalBtn">Cancel</button>
                    <button type="submit">Save</button>
                </div>
            </form>
        </div>
    </div>

    <div id="publishModal" style="display:none;">
        <div class="modalContent">
            <h2>Publish Assessment</h2>

            <div class="publishInfo">
                <p><strong>Type:</strong> <span id="publishAssessmentType"></span></p>
                <p><strong>Component:</strong> <span id="publishComponent"></span></p>
                <p><strong>Band:</strong> <span id="publishBand"></span></p>
                <p><strong>Passing / Total Mark:</strong> <span id="publishMarks"></span></p>
            </div>

            <form id="publishForm">
                <input type="hidden" id="publishAssessmentId" />

                <label for="dueDate">Due Date</label>
                <input type="date" id="dueDate" required />

                <div class="modalActions">
                    <button type="button" id="cancelPublishBtn">Cancel</button>
                    <button type="submit">Publish</button>
                </div>
            </form>

        </div>
    </div>

    <div id="rubricsModal" style="display:none;">
        <div class="modalContent">
            <h2 id="modalTitle">Rubrics</h2>
            <p id="rubricsModalContent" style="white-space: pre-wrap;"></p>
            <div class="modalActions">
                <button type="button" id="closeRubricsBtn">Close</button>
            </div>
        </div>
    </div>

    <script src="/javascripts/assessmentList.js"></script>

</body>

</html>