<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Assessment List</title>

    <!-- Shared navbar and sidebar styling -->
    <link rel="stylesheet" href="/stylesheets/bands.css">

    <!-- Assessment page styling -->
    <link rel="stylesheet" href="/stylesheets/assessmentList.css">
</head>

<body data-semester-id="<%= semesterId %>" data-semester-band-id="<%= semesterBandId %>" data-band="<%= bandCode %>">
    <div class="app-shell">

        <!-- Top navbar -->
        <%- include('./partials/top-nav', { activeTop: 'bands' }) %>

            <!-- Sidebar -->
            <%- include('./partials/sidebar', { type: 'band' , activeSide: 'assessments' , semesterId: semesterId,
                semesterBandId: semesterBandId, band: band }) %>

                <!-- Main assessment content -->
                <main class="content-page assessment-list-page">

                    <div class="page-title-row assessment-title-row">
                        <h1 id="assessmentCountTitle">0 Assessments</h1>

                        <button class="button secondary" id="addAssessmentBtn" type="button">
                            + Create Assessment
                        </button>
                    </div>

                    <div class="toolbar assessment-filter-toolbar">
                        <div class="filters">
                            <select class="filterInput" id="filterAssessmentType" name="assessmentType"
                                aria-label="Filter by assessment type">
                                <option value="">All Types</option>
                                <option value="Letter Formation">Letter Formation</option>
                                <option value="Narrative Writing">Narrative Writing</option>
                                <option value="Exposition Writing">Exposition Writing</option>
                                <option value="Edit and Diagram 1">Edit and Diagram 1</option>
                                <option value="Edit and Diagram 2">Edit and Diagram 2</option>
                                <option value="Edit and Diagram 3">Edit and Diagram 3</option>
                                <option value="Comprehension">Comprehension</option>
                                <option value="Primary">Primary</option>
                                <option value="Secondary">Secondary</option>
                                <option value="Picture Naming">Picture Naming</option>
                                <option value="Picture Description">Picture Description</option>
                                <option value="PA Identification">PA Identification</option>
                                <option value="Phonics">Phonics</option>
                                <option value="Word Reading Accuracy">Word Reading Accuracy</option>
                                <option value="Fluency">Fluency</option>
                                <option value="Word Spelling">Word Spelling</option>
                            </select>

                            <select class="filterInput" id="filterComponent" name="component"
                                aria-label="Filter by component">
                                <option value="">All Components</option>
                                <option value="Vocabulary">Vocabulary</option>
                                <option value="Writing">Writing</option>
                                <option value="Comprehension">Comprehension</option>
                                <option value="PA / Phonics">PA / Phonics</option>
                            </select>
                        </div>
                    </div>

                    <div class="table-wrap assessmentTableWrapper">
                        <table id="assessment-table">
                            <thead>
                                <tr>
                                    <th>Assessment Type</th>
                                    <th>Component</th>
                                    <th>Submitted</th>
                                    <th>Graded</th>
                                    <th>Passing Mark</th>
                                    <th>Total Mark</th>
                                    <th>Weightage</th>
                                    <th>Rubrics</th>
                                    <th>Published</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tbody id="assessmentTableBody">
                                <!-- JavaScript inserts assessment rows here -->
                            </tbody>
                        </table>
                    </div>
                </main>
    </div>

    <!-- Create/Edit Assessment Modal -->
    <div id="assessmentModal" style="display: none;" role="presentation">
        <div class="modalContent" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
            <h2 id="modalTitle">Create Assessment</h2>

            <p id="editLockNotice" class="editLockNotice" style="display: none;">
                This assessment was previously published. Only rubrics can be changed.
            </p>

            <form id="assessmentForm">
                <input type="hidden" id="assessmentId">

                <label for="assessmentType">
                    Assessment Type <span class="required-asterisk">*</span>
                </label>

                <select id="assessmentType" required>
                    <option value="" disabled selected>Select Type</option>
                    <option value="Letter Formation">Letter Formation</option>
                    <option value="Narrative Writing">Narrative Writing</option>
                    <option value="Exposition Writing">Exposition Writing</option>
                    <option value="Edit and Diagram 1">Edit and Diagram 1</option>
                    <option value="Edit and Diagram 2">Edit and Diagram 2</option>
                    <option value="Edit and Diagram 3">Edit and Diagram 3</option>
                    <option value="Comprehension">Comprehension</option>
                    <option value="Primary">Primary</option>
                    <option value="Secondary">Secondary</option>
                    <option value="Picture Naming">Picture Naming</option>
                    <option value="Picture Description">Picture Description</option>
                    <option value="PA Identification">PA Identification</option>
                    <option value="Phonics">Phonics</option>
                    <option value="Word Reading Accuracy">Word Reading Accuracy</option>
                    <option value="Fluency">Fluency</option>
                    <option value="Word Spelling">Word Spelling</option>
                </select>

                <label for="component">
                    Component <span class="required-asterisk">*</span>
                </label>

                <select id="component" required>
                    <option value="" disabled selected>Select Component</option>
                    <option value="Vocabulary">Vocabulary</option>
                    <option value="Writing">Writing</option>
                    <option value="Comprehension">Comprehension</option>
                    <option value="PA / Phonics">PA / Phonics</option>
                </select>

                <label for="passingMark">
                    Passing Mark <span class="required-asterisk">*</span>
                </label>

                <input type="number" id="passingMark" min="0" step="1" required>

                <label for="totalMark">
                    Total Mark <span class="required-asterisk">*</span>
                </label>

                <input type="number" id="totalMark" min="0" step="1" required>

                <label for="weight">
                    Weightage <span class="required-asterisk">*</span>
                </label>

                <!-- shown here for reference, only Band Settings can change it -->
                <input type="number" id="weight" value="0" step="0.0001" disabled>

                <label for="rubrics">
                    Rubrics
                </label>

                <textarea id="rubrics" rows="10" cols="50" placeholder="Enter rubrics"></textarea>

                <div class="modalActions">
                    <button type="button" id="cancelModalBtn">
                        Cancel
                    </button>

                    <button type="submit">
                        Save
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Publish Assessment Modal -->
    <div id="publishModal" style="display: none;" role="presentation">
        <div class="modalContent" role="dialog" aria-modal="true" aria-labelledby="publishModalTitle">
            <h2 id="publishModalTitle">Publish Assessment</h2>

            <div class="publishInfo">
                <p>
                    <strong>Type:</strong>
                    <span id="publishAssessmentType"></span>
                </p>

                <p>
                    <strong>Component:</strong>
                    <span id="publishComponent"></span>
                </p>

                <p>
                    <strong>Band:</strong>
                    <span id="publishBand"></span>
                </p>

                <p>
                    <strong>Passing / Total Mark:</strong>
                    <span id="publishMarks"></span>
                </p>
            </div>

            <form id="publishForm">
                <input type="hidden" id="publishAssessmentId">

                <label for="dueDate">
                    Due Date <span class="required-asterisk">*</span>
                </label>

                <input type="date" id="dueDate" required>

                <div class="modalActions">
                    <button type="button" id="cancelPublishBtn">
                        Cancel
                    </button>

                    <button type="submit">
                        Publish
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Rubrics Modal -->
    <div id="rubricsModal" style="display: none;" role="presentation">
        <div class="modalContent" role="dialog" aria-modal="true" aria-labelledby="rubricsModalTitle">
            <h2 id="rubricsModalTitle">Rubrics</h2>

            <p id="rubricsModalContent"></p>

            <div class="modalActions">
                <button type="button" id="closeRubricsBtn">
                    Close
                </button>
            </div>
        </div>
    </div>

    <!-- Include this if it controls the shared sidebar -->
    <script src="/javascripts/bands.js"></script>

    <script src="/javascripts/assessmentList.js"></script>
</body>

</html>
